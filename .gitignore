# --- ESP-IDF generated output ---------------------------------------------
# Build tree and the component-manager download cache are fully regenerable.
build/
managed_components/
sdkconfig.old

# Recovered/corrupted Git metadata backups are local recovery material only.
.git.broken-*/

# --- Python bytecode caches ------------------------------------------------
__pycache__/
*.py[cod]

# --- Transient serial captures and traces ----------------------------------
# boot*.log, cap_*.log, trace*.log, live_test.log, probe_run.log, set_target.log
*.log

# --- Local, machine-specific state ----------------------------------------
# Serial-port/device bindings, host bridge state, recovery images.
.local/
*.local.json

# --- WorkBuddy workspace state --------------------------------------------
# Agent skills and daily memory. Local only: never committed, never pushed.
.workbuddy-ai/skills/
.workbuddy-ai/memory/

# --- UI replacement kit ----------------------------------------------------
# Local tooling and notes for swapping the dashboard art. Kept out of the
# tree so a restyle never lands in a commit by accident.
tools/apply_ui_assets.py
UI_REPLACE.md
/tmp/
